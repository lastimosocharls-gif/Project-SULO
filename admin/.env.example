# ─── SULO Admin Dashboard Environment Variables ───
# Copy this file to .env and fill in your Supabase credentials

# ─── Supabase Configuration ───
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Dashboard Configuration ───
# Optional: Set to true for demo mode (uses simulated data)
DEMO_MODE=false

# ─── Alert Configuration ───
# Optional: Enable email alerts (requires Supabase Edge Functions)
ENABLE_EMAIL_ALERTS=false
ALERT_EMAIL=admin@sulo.local

# ─── Refresh Interval ───
# How often to fetch new data (in milliseconds)
REFRESH_INTERVAL=5000

# ─── Chart History ───
# How many hours of history to show in charts
CHART_HISTORY_HOURS=24
